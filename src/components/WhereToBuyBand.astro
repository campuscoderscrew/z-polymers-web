---
/**
 * The page's single cream band: the "Where to buy" call to action.
 * Use at most once per page. Don't place it directly after another cream band.
 */
import Section from './Section.astro';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Where to buy Tullomer™',
  text = 'Buy filament and fiber from Z-Polymers directly or through an authorized distributor.',
} = Astro.props;
---
<Section tone="cream" id="where-to-buy-cta" heading={heading}>
  <div class="flex flex-col items-center gap-6 text-center">
    <p class="type-lede">{text}</p>
    <a
      href="/where-to-buy"
      class="btn inline-flex min-h-12 items-center justify-center rounded-btn bg-ink px-6 font-display font-semibold text-cream no-underline hover:text-cream hover:opacity-90"
    >
      Find a seller
    </a>
  </div>
</Section>
