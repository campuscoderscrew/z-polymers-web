---
/** Page hero: eyebrow, .type-hero title, .type-lede intro, optional actions slot. */
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}
const { title, lede, eyebrow } = Astro.props;
---
<section class="bg-bg pt-16 pb-16 md:pt-24 md:pb-24">
  <div class="container-site flex flex-col items-start gap-6">
    {eyebrow && <p class="type-label">{eyebrow}</p>}
    <h1 class="type-hero max-w-[18ch]">{title}</h1>
    {lede && <p class="type-lede">{lede}</p>}
    {Astro.slots.has('default') && <div class="flex flex-wrap gap-4 pt-2"><slot /></div>}
  </div>
</section>
