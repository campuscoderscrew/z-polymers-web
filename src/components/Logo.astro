---
/**
 * Z-Polymers logo. Inherits the current text color (fill="currentColor"):
 * use text-logo on normal grounds; inside .band-steel / .band-cream it
 * switches to white / ink automatically.
 * Never stretch, rotate or add effects. Size it with a height class only.
 *
 * PLACEHOLDER artwork until the final logo file from the brand guide lands.
 * Replace the <svg> contents (keep fill="currentColor").
 */
interface Props {
  class?: string;
  /** Accessible name. Pass "" when the logo sits next to visible text that already names it. */
  title?: string;
}
const { class: className = 'h-8', title = 'Z-Polymers' } = Astro.props;
---
<svg
  class:list={['text-logo w-auto shrink-0', className]}
  viewBox="0 0 220 40"
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-label={title || undefined}
  aria-hidden={title ? undefined : 'true'}
  preserveAspectRatio="xMinYMid meet"
>
  <path d="M4 6h28v5L13 30h19v5H3v-5l19-19H4z" />
  <text x="44" y="29" font-family="Quicksand, sans-serif" font-weight="600" font-size="22" letter-spacing="1">
    Z-POLYMERS
  </text>
</svg>
